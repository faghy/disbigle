# Copy to .env and adjust.
NODE_ENV=development
# Public origin of the instance (scheme + host, no trailing slash).
PUBLIC_URL=http://localhost:5173
# Domain used in handles (user@LOCAL_DOMAIN).
LOCAL_DOMAIN=localhost:5173
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://localhost:5432/disbigle_development
REDIS_URL=redis://localhost:6379/0
# 64+ random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me
# open | approval | invite | closed
REGISTRATION_MODE=open
MEDIA_DIR=./storage/media
# Shown on the landing page and in NodeInfo.
INSTANCE_TITLE=Disbigle
INSTANCE_DESCRIPTION=
# Outgoing email (password resets). Leave empty in development: emails are printed to the log.
SMTP_URL=
MAIL_FROM=Disbigle <noreply@example.org>
