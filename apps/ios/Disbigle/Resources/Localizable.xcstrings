    "Changing the options or the kind of poll clears the votes cast so far.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Optionen oder die Art der Umfrage änderst, werden die bisherigen Stimmen gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cambias las opciones o el tipo de encuesta, se borran los votos emitidos hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer les options ou le type de sondage efface les votes déjà exprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambi le opzioni o il tipo di sondaggio, i voti già dati vengono azzerati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改选项或投票类型会清除目前已投的票。"
          }
        }
      }
    },
    "Choosing aspects shares the post with their members only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Aspekte wählst, wird der Beitrag nur mit ihren Mitgliedern geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliges aspectos, la publicación se comparte solo con sus miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir des aspects partage la publication uniquement avec leurs membres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliendo degli aspetti, il post è condiviso solo con chi ne fa parte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择分组后，帖子只会分享给这些分组的成员。"
