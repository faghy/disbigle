    "Reports go to the moderators, who act within 24 hours. You can also block or mute this person.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen gehen an die Moderation, die innerhalb von 24 Stunden handelt. Du kannst diese Person auch blockieren oder stummschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias llegan a los moderadores, que actúan en 24 horas. También puedes bloquear o silenciar a esta persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements vont aux modérateurs, qui agissent sous 24 heures. Tu peux aussi bloquer ou masquer cette personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni arrivano ai moderatori, che intervengono entro 24 ore. Puoi anche bloccare o silenziare questa persona."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报会发送给审核员，他们会在 24 小时内处理。你也可以屏蔽或隐藏这个人。"
          }
        }
      }
    },
