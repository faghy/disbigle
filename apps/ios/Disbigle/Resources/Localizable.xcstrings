    "On iPhone, Dark uses pure black: on OLED screens those pixels switch off, saving battery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone nutzt Dunkel reines Schwarz: Auf OLED-Bildschirmen schalten sich diese Pixel ab und sparen Akku."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone, Oscuro usa el negro puro: en las pantallas OLED esos píxeles se apagan y la batería dura más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, Sombre utilise un noir pur : sur les écrans OLED, ces pixels s'éteignent, ce qui économise la batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone, Scuro usa il nero puro: sugli schermi OLED quei pixel si spengono e la batteria dura di più."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上，深色模式使用纯黑色：在 OLED 屏幕上，这些像素会关闭，从而节省电量。"
          }
        }
      }
    },
