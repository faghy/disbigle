    "iOS settings for Disbigle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-Einstellungen für Disbigle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes de iOS para Disbigle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages iOS pour Disbigle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di iOS per Disbigle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Disbigle 的 iOS 设置"
          }
        }
      }
    },
    "iOS wakes Disbigle from time to time to look for new notifications, usually every 15–30 minutes and less often when the battery is low. Keep Background App Refresh on for Disbigle in the iOS settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS weckt Disbigle ab und zu, um nach neuen Mitteilungen zu suchen, meist alle 15–30 Minuten und seltener bei niedrigem Akkustand. Lass „Hintergrundaktualisierung“ für Disbigle in den iOS-Einstellungen eingeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS activa Disbigle de vez en cuando para buscar notificaciones nuevas, normalmente cada 15–30 minutos y con menos frecuencia si queda poca batería. Mantén activada la actualización en segundo plano para Disbigle en los ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS réveille Disbigle de temps en temps pour chercher de nouvelles notifications, en général toutes les 15 à 30 minutes et moins souvent quand la batterie est faible. Laisse l'actualisation en arrière-plan activée pour Disbigle dans les réglages d'iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS riattiva Disbigle ogni tanto per cercare nuove notifiche, di solito ogni 15–30 minuti e meno spesso con la batteria scarica. Tieni attivo l'aggiornamento app in background per Disbigle nelle impostazioni di iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会不时唤醒 Disbigle 来检查新通知，通常每 15 到 30 分钟一次，电量低时频率会降低。请在 iOS 设置中为 Disbigle 保持开启“后台 App 刷新”。"
          }
        }
      }
    },
