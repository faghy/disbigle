[Unit]
Description=Disbigle machine translation (Bergamot)
After=network.target

[Service]
Type=simple
User=disbigle
# The bergamot package keeps its own cache and settings in the home directory.
Environment=HOME=/var/lib/disbigle/translator
Environment=TRANSLATOR_MODELS=/var/lib/disbigle/translator/models
Environment=TRANSLATOR_PORT=5100
ExecStart=/opt/disbigle/translator-venv/bin/python /opt/disbigle/apps/translator/server.py
Restart=on-failure
RestartSec=5
# Models are dropped after 10 idle minutes; keep a ceiling in case many are in use at once.
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Each model folder gets the engine configuration written next to it.
ReadWritePaths=/var/lib/disbigle/translator

[Install]
WantedBy=multi-user.target
