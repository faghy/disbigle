[Unit]
Description=Disbigle API server
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=disbigle
WorkingDirectory=/opt/disbigle/apps/server
EnvironmentFile=/etc/disbigle/env
Environment=NODE_ENV=production
Environment=TRUST_PROXY=true
# Let the worker drain the federation queue.
Environment=RUN_FEDERATION_QUEUE=false
Environment=RUN_DIASPORA_QUEUE=false
ExecStart=/opt/disbigle/node_modules/.bin/tsx src/main.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/disbigle

[Install]
WantedBy=multi-user.target
