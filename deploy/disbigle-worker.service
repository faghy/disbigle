[Unit]
Description=Disbigle background worker (federation delivery, maintenance)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=disbigle
WorkingDirectory=/opt/disbigle/apps/worker
EnvironmentFile=/etc/disbigle/env
Environment=NODE_ENV=production
ExecStart=/opt/disbigle/node_modules/.bin/tsx src/main.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/disbigle

[Install]
WantedBy=multi-user.target
